# Вариант 1 (локально): база — Excel-файл
DB_PATH=data/coffee.xlsx
# Вариант 2 (хостинг): бесплатная облачная база Postgres, например neon.tech.
# Если задано — Excel-файл не используется, а выгружается кнопкой «Excel-база».
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Меню напитков через запятую (необязательно)
